GEMINI_API_KEY=your-gemini-api-key-here
# Optional, defaults to gemini-3.6-flash. See https://ai.google.dev/gemini-api/docs/models
# GEMINI_MODEL=gemini-3.6-flash

# Secret used to sign "Remember me" session cookies.
# Change this to a long random string in production — anyone with this value
# can forge login cookies.
COOKIE_SECRET=change-me-to-a-long-random-string

# Used for passkey (WebAuthn) registration/login. Must match the domain the
# app is actually served from — passkeys silently fail to verify otherwise.
# Defaults to localhost for local dev; set both when deploying, e.g.:
# WEBAUTHN_RP_ID=your-app.streamlit.app
# WEBAUTHN_ORIGIN=https://your-app.streamlit.app
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8501
